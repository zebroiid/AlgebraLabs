    {
      "id": "b7da98",
      "cell_type": "code",
      "source": [
        "def isPrime(x):\n",
        "    if x <= 1:\n",
        "        return False\n",
        "    for i in range(2, int(sqrt(x))+1):\n",
        "        if x % i == 0:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "print(isPrime(5))\n",
        "print(isPrime(77))\n",
        "print(isPrime(101))"
      ],
      "metadata": {
        "collapsed": false
      },
      "execution_count": 33,
      "outputs": [
        {
          "name": "stdout",
          "text": [
            "True\n",
            "False\n",
            "True\n"
          ],
          "output_type": "stream"
        }
